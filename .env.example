# Скопируйте этот файл в .env в корне репозитория.
# Адрес существующего API, доступный из Docker-контейнера.
# Укажите http:// или https://, без /docs, /openapi.json и /api.
# Ниже текущий адрес из Swagger; замените, если API перенесён.
API_UPSTREAM=http://ai-mentor.tw1.ru:8000

# Порт, на котором будет доступно приложение: http://SERVER_IP:8080.
# Если нужен прямой HTTP на стандартном порту, укажите 80.
WEB_PORT=8080

# Если API запущен на том же сервере вне этого контейнера:
# API_UPSTREAM=http://host.docker.internal:8000
# localhost и 127.0.0.1 внутри контейнера означают сам контейнер фронтенда.
